{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@creditmesh/core": ["../../packages/core/src/index.ts"],
      "@creditmesh/core/*": ["../../packages/core/src/*"],
      "@creditmesh/adapters": ["../../packages/adapters/src/index.ts"],
      "@creditmesh/adapters/*": ["../../packages/adapters/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
