{
  "name": "creditmesh",
  "private": true,
  "version": "0.1.0",
  "description": "CreditMesh — Counterparty Credit & Collateral Intelligence Platform",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @creditmesh/web",
    "build": "npm run build --workspace @creditmesh/web",
    "start": "npm run start --workspace @creditmesh/web",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "lint:no-tenant-names": "node scripts/check-no-tenant-names.mjs",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.5"
  },
  "engines": { "node": ">=20.11" }
}
